{
  "name": "expo-ai-assistant",
  "version": "0.1.14",
  "description": "Surface-first AI chat kit for Expo and React Native — pluggable transport (OpenAI-compatible default), full-page, floating, modal, and optional bottom-sheet.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "expo-ai-assistant-source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./full-page": {
      "expo-ai-assistant-source": "./src/full-page/index.ts",
      "types": "./lib/typescript/full-page/index.d.ts",
      "default": "./lib/module/full-page/index.js"
    },
    "./floating": {
      "expo-ai-assistant-source": "./src/floating/index.ts",
      "types": "./lib/typescript/floating/index.d.ts",
      "default": "./lib/module/floating/index.js"
    },
    "./bottom-sheet": {
      "expo-ai-assistant-source": "./src/bottom-sheet/index.ts",
      "types": "./lib/typescript/bottom-sheet/index.d.ts",
      "default": "./lib/module/bottom-sheet/index.js"
    },
    "./modal": {
      "expo-ai-assistant-source": "./src/modal/index.ts",
      "types": "./lib/typescript/modal/index.d.ts",
      "default": "./lib/module/modal/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/.*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify:gorhom": "node scripts/verify-gorhom-isolation.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "npm --prefix example start",
    "example:go": "npm --prefix example run start:go",
    "example:ios": "npm --prefix example run ios",
    "example:android": "npm --prefix example run android",
    "example:publish": "npm --prefix example run publish:go"
  },
  "keywords": [
    "expo",
    "react-native",
    "ai",
    "assistant",
    "chat",
    "streaming",
    "bottom-sheet",
    "floating",
    "modal",
    "openai"
  ],
  "author": "melihmuratpesmen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melihmuratpesmen/expo-ai-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/melihmuratpesmen/expo-ai-assistant/issues"
  },
  "homepage": "https://github.com/melihmuratpesmen/expo-ai-assistant#readme",
  "peerDependencies": {
    "@expo/vector-icons": ">=14.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0",
    "expo-clipboard": ">=7.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-gesture-handler": ">=2.14.0",
    "react-native-keyboard-controller": ">=1.14.0",
    "react-native-markdown-display": ">=7.0.0",
    "react-native-reanimated": ">=3.6.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@gorhom/bottom-sheet": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "react-native-markdown-display": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native/babel-preset": "^0.81.6",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "test-renderer": "^1.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
